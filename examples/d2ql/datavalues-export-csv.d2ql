// Export a quarter of raw data values (startDate/endDate window over a subtree) to a CSV file.
// Combines the dataValues date-window args with a `>>` file sink (format from the extension).
dataValues(dataSet: "BfMAe6Itzgt", startDate: "2024-01-01", endDate: "2024-03-31", orgUnit: "ImspTQPwCqd", children: true)
  | transform { de: dataElement, pe: period, ou: orgUnit, value: value }
  | limit 500
  >> "/tmp/data-values-q1.csv"

// `transform` runs once PER ROW, so this yields an ARRAY of Observation objects
// (one per data element) — not a single Bundle. For one Bundle envelope wrapping
// them, see fhir-bundle-de.d2ql, which adds a `fold` over the whole stream.
dataElements
  | where domainType = "AGGREGATE"
  | transform {
      resourceType: "Observation",
      status: "final",
      code: { coding: [ { system: "dhis2", code: id, display: name } ] }
    }
  | limit 25

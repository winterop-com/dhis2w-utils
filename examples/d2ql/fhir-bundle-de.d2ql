// A *proper* FHIR Bundle: define functions build each Observation, `transform`
// wraps each row as a Bundle entry, and `fold` collapses the whole stream into
// one Bundle envelope object (not an array of resources).
define function observation(de): {
  resourceType: "Observation",
  status: "final",
  code: { coding: [ { system: "dhis2", code: $de.id, display: $de.name } ] }
}

dataElements
  | where domainType = "AGGREGATE"
  | limit 25
  | transform { resource: observation($this) }
  | fold { resourceType: "Bundle", type: "collection", entry: $rows }

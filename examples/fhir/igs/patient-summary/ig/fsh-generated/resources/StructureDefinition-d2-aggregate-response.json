{
  "resourceType": "StructureDefinition",
  "id": "d2-aggregate-response",
  "url": "http://example.org/fhir/examples/patient-summary/StructureDefinition/d2-aggregate-response",
  "name": "D2AggregateResponse",
  "title": "DHIS2 aggregate response",
  "status": "draft",
  "experimental": true,
  "description": "One submission of a DHIS2 data set form: the values captured for one organisation unit, one reporting period, and one attribute option combo, answered on the linkIds of the data set's Questionnaire.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "QuestionnaireResponse",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "QuestionnaireResponse.extension",
        "path": "QuestionnaireResponse.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "ordered": false,
          "rules": "open"
        },
        "min": 2
      },
      {
        "id": "QuestionnaireResponse.extension:D2Period",
        "path": "QuestionnaireResponse.extension",
        "sliceName": "D2Period",
        "short": "The DHIS2 reporting period the values were captured for.",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://example.org/fhir/examples/patient-summary/StructureDefinition/d2-period"
            ]
          }
        ]
      },
      {
        "id": "QuestionnaireResponse.extension:D2AttributeOptionCombo",
        "path": "QuestionnaireResponse.extension",
        "sliceName": "D2AttributeOptionCombo",
        "short": "The DHIS2 attribute option combo the values were captured under. A response answering a form that declares a D2AttributeOptionCombos vocabulary has to carry it, coded from that ValueSet; absent means the default attribute option combo, which is the only combo a form without that extension has.",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://example.org/fhir/examples/patient-summary/StructureDefinition/d2-attribute-option-combo"
            ]
          }
        ]
      },
      {
        "id": "QuestionnaireResponse.extension:D2FormType",
        "path": "QuestionnaireResponse.extension",
        "sliceName": "D2FormType",
        "short": "The DHIS2 form kind this response answers.",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://example.org/fhir/examples/patient-summary/StructureDefinition/d2-form-type"
            ]
          }
        ]
      },
      {
        "id": "QuestionnaireResponse.extension:D2FormType.value[x]",
        "path": "QuestionnaireResponse.extension.value[x]",
        "fixedCode": "aggregate"
      },
      {
        "id": "QuestionnaireResponse.questionnaire",
        "path": "QuestionnaireResponse.questionnaire",
        "min": 1
      },
      {
        "id": "QuestionnaireResponse.subject",
        "path": "QuestionnaireResponse.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://example.org/fhir/examples/patient-summary/StructureDefinition/d2-location"
            ]
          }
        ]
      }
    ]
  }
}

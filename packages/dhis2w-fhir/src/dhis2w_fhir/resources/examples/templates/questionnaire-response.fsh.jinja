Instance: QuestionnaireResponse-{{ example.instance_id }}
InstanceOf: {{ example.instance_of }}
Title: {{ example.title_literal }}
Description: {{ example.description_literal }}
Usage: #example
* id = "{{ example.instance_id }}"
* extension[{{ example.form_type_extension }}].valueCode = #{{ example.form_type_code }}
{% if example.period is not none %}
* extension[{{ example.period.extension }}].extension[iso].valueString = "{{ example.period.iso }}"
* extension[{{ example.period.extension }}].extension[type].valueCode = #{{ example.period.period_type }}
* extension[{{ example.period.extension }}].extension[period].valuePeriod.start = "{{ example.period.start_date }}"
* extension[{{ example.period.extension }}].extension[period].valuePeriod.end = "{{ example.period.end_date }}"
{% endif %}
{% if example.attribute_option_combo is not none %}
* extension[{{ example.attribute_option_combo.extension }}].valueCoding = {{ example.attribute_option_combo.coding_literal }}
{% endif %}
{% if example.tracker is not none %}
{% if example.tracker.enrollment_uid is not none %}
* extension[{{ example.tracker.enrollment_extension }}].valueIdentifier.system = $DHIS2-TRACKER-ENROLLMENT
* extension[{{ example.tracker.enrollment_extension }}].valueIdentifier.value = "{{ example.tracker.enrollment_uid }}"
{% endif %}
{% if example.tracker.organisation_unit_stem %}
* extension[{{ example.tracker.organisation_unit_extension }}].valueReference = Reference(Location/{{ example.tracker.organisation_unit_stem }})
{% endif %}
{% if example.tracker.enrolled_at is not none %}
* extension[{{ example.tracker.enrolled_at_extension }}].valueDateTime = "{{ example.tracker.enrolled_at }}"
{% endif %}
{% if example.tracker.incident_at is not none %}
* extension[{{ example.tracker.incident_at_extension }}].valueDateTime = "{{ example.tracker.incident_at }}"
{% endif %}
{% endif %}
* questionnaire = "{{ example.questionnaire_url }}"
* status = #{{ example.status_code }}
{% if example.tracker is none %}
* subject = Reference(Location/{{ example.organisation_unit_stem }})
{% elif example.tracker.tracked_entity_uid is not none %}
* subject.type = "Patient"
* subject.identifier.system = $DHIS2-TE
* subject.identifier.value = "{{ example.tracker.tracked_entity_uid }}"
{% endif %}
{% if example.authored is not none %}
* authored = "{{ example.authored }}"
{% endif %}
{% for item in example.items %}
* {{ item.new_path }}.linkId = "{{ item.link_id }}"
{% for answer in item.answers %}
* {{ item.path }}.answer[+].{{ answer.element }} = {{ answer.literal }}
{% endfor %}
{% endfor %}

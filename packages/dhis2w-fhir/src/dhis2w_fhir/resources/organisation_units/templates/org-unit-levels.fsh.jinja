CodeSystem: {{ names.level_code_system }}
Id: {{ names.terminology_id('level', 'cs') }}
Title: {{ terminology.title_literal }}
Description: {{ terminology.description_literal }}
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* ^content = #complete
* ^caseSensitive = true
* ^valueSet = Canonical({{ names.level_value_set }})
{% for level in levels %}
* #level-{{ level }} "Level {{ level }}"
{% endfor %}

ValueSet: {{ names.level_value_set }}
Id: {{ names.terminology_id('level', 'vs') }}
Title: {{ terminology.title_literal }}
Description: {{ terminology.value_set_description_literal }}
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* include codes from system {{ names.level_code_system }}

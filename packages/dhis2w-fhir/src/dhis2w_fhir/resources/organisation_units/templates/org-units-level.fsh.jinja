{% for pair in pairs %}
{% if not loop.first %}

{% endif %}
{% set organization = pair.organization %}
{% set location = pair.location %}
Instance: Organization{{ organization.uid }}
InstanceOf: {{ organization.profile }}
Title: {{ organization.title_literal }}
Description: {{ organization.description_literal }}
Usage: #example
* identifier[dhis2uid].system = $DHIS2-OU
* identifier[dhis2uid].type = $V2-0203#RI
* identifier[dhis2uid].value = "{{ organization.uid }}"
{% if organization.code_literal is not none %}
* identifier[dhis2code].system = $DHIS2-OU-CODE
* identifier[dhis2code].type = $V2-0203#XX
* identifier[dhis2code].value = {{ organization.code_literal }}
{% endif %}
* name = {{ organization.name_literal }}
{% if organization.alias_literal is not none %}
* alias = {{ organization.alias_literal }}
{% endif %}
* type = {{ organization.level_code_system }}#level-{{ organization.level }} "Level {{ organization.level }}"
{% if organization.parent_uid is not none %}
* partOf = Reference(Organization{{ organization.parent_uid }})
{% endif %}
{% if organization.phone_literal is not none %}
* telecom[+].system = #phone
* telecom[=].value = {{ organization.phone_literal }}
{% endif %}
{% if organization.email_literal is not none %}
* telecom[+].system = #email
* telecom[=].value = {{ organization.email_literal }}
{% endif %}
{% if organization.contact_literal is not none %}
* contact[+].name.text = {{ organization.contact_literal }}
{% endif %}
* active = true

Instance: Location{{ location.uid }}
InstanceOf: {{ location.profile }}
Title: {{ location.title_literal }}
Usage: #example
* name = {{ location.name_literal }}
* status = #active
{% if location.position is not none %}
* position.latitude = {{ location.position.latitude }}
* position.longitude = {{ location.position.longitude }}
{% endif %}
{% if location.boundary_data is not none %}
* extension[+].url = "{{ boundary_extension_url }}"
* extension[=].valueAttachment.contentType = #application/geo+json
* extension[=].valueAttachment.data = "{{ location.boundary_data }}"
{% endif %}
* managingOrganization = Reference(Organization{{ location.uid }})
{% if location.parent_uid is not none %}
* partOf = Reference(Location{{ location.parent_uid }})
{% endif %}
{% endfor %}

Profile: {{ names.organization_profile }}
Parent: Organization
Id: {{ names.organization_profile_id }}
Title: "DHIS2 Organization"
Description: "An organisation unit imported from DHIS2."
* ^status = #active
* identifier ^slicing.discriminator.type = #value
* identifier ^slicing.discriminator.path = "system"
* identifier ^slicing.rules = #open
* identifier contains dhis2id 1..1 and dhis2code 1..1
* identifier[dhis2id].system = $DHIS2-OU
* identifier[dhis2code].system = $DHIS2-OU-CODE
* active 1..1
* type 1..*
* type from {{ names.level_value_set }} (extensible)
* name 1..1
* partOf only Reference({{ names.organization_profile }})

Profile: {{ names.location_profile }}
Parent: Location
Id: {{ names.location_profile_id }}
Title: "DHIS2 Location"
Description: "The physical place of a DHIS2 organisation unit."
* ^status = #active
* identifier ^slicing.discriminator.type = #value
* identifier ^slicing.discriminator.path = "system"
* identifier ^slicing.rules = #open
* identifier contains dhis2id 1..1 and dhis2code 1..1
* identifier[dhis2id].system = $DHIS2-OU
* identifier[dhis2code].system = $DHIS2-OU-CODE
* name 1..1
* status 1..1
* position 0..1 MS
* extension contains {{ boundary_extension_url }} named boundary 0..1
* extension[boundary] ^short = "The unit's DHIS2 geometry, carried as a GeoJSON Feature in the attachment."
* managingOrganization 1..1
* managingOrganization only Reference({{ names.organization_profile }})
* partOf only Reference({{ names.location_profile }})

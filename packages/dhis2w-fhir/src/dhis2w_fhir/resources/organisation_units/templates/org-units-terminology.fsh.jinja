CodeSystem: {{ names.organisation_unit_code_system }}
Id: {{ names.terminology_id('cs') }}
Title: "DHIS2 organisation units"
Description: "DHIS2 organisation units. Concept codes are DHIS2 organisation unit UIDs."
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* ^content = #complete
* ^caseSensitive = true
* ^valueSet = Canonical({{ names.organisation_unit_value_set }})
* ^property[+].code = #level
* ^property[=].uri = "{{ property_base }}/level"
* ^property[=].description = "DHIS2 organisation unit hierarchy level."
* ^property[=].type = #integer
* ^property[+].code = #parent
* ^property[=].uri = "{{ property_base }}/parent"
* ^property[=].description = "Parent organisation unit UID."
* ^property[=].type = #code
* ^property[+].code = #dhis2-code
* ^property[=].uri = "{{ property_base }}/dhis2-code"
* ^property[=].description = "DHIS2 organisation unit code."
* ^property[=].type = #string
{% for concept in concepts %}
* #{{ concept.uid }} {{ concept.display_literal }}
* #{{ concept.uid }} ^property[+].code = #level
* #{{ concept.uid }} ^property[=].valueInteger = {{ concept.level }}
{% if concept.parent_uid is not none %}
* #{{ concept.uid }} ^property[+].code = #parent
* #{{ concept.uid }} ^property[=].valueCode = #{{ concept.parent_uid }}
{% endif %}
{% if concept.code_literal is not none %}
* #{{ concept.uid }} ^property[+].code = #dhis2-code
* #{{ concept.uid }} ^property[=].valueString = {{ concept.code_literal }}
{% endif %}
{% for designation in concept.designations %}
* #{{ concept.uid }} ^designation[+].language = #{{ designation.locale }}
* #{{ concept.uid }} ^designation[=].value = {{ designation.value_literal }}
{% endfor %}
{% endfor %}

ValueSet: {{ names.organisation_unit_value_set }}
Id: {{ names.terminology_id('vs') }}
Title: "DHIS2 organisation units"
Description: "All DHIS2 organisation units in the generated selection."
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* include codes from system {{ names.organisation_unit_code_system }}

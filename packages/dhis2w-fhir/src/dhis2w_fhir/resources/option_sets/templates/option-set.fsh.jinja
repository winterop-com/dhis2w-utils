CodeSystem: {{ base_name }}CS
Id: {{ id_stem }}{{ slug }}-cs
Title: {{ title }}
Description: {{ description }}
{% for translation in title_translations %}
* ^title.extension[+].url = "{{ translation_extension_url }}"
* ^title.extension[=].extension[+].url = "lang"
* ^title.extension[=].extension[=].valueCode = #{{ translation.locale }}
* ^title.extension[=].extension[+].url = "content"
* ^title.extension[=].extension[=].valueString = {{ translation.value_literal }}
{% endfor %}
{% for identifier in identifiers %}
* ^identifier[+].system = "{{ identifier.system }}"
* ^identifier[=].value = "{{ identifier.value }}"
{% endfor %}
* ^status = #active
* ^content = #complete
* ^caseSensitive = true
* ^valueSet = Canonical({{ base_name }}VS)
{% for declaration in declarations %}
* ^property[+].code = #{{ declaration.code }}
* ^property[=].description = "{{ declaration.description }}"
* ^property[=].type = #{{ declaration.type }}
{% endfor %}
{% for concept in concepts %}
* {{ concept.token }} {{ concept.display_literal }}
{% if concept.property_code is not none %}
* {{ concept.token }} ^property[+].code = #{{ concept.property_code }}
* {{ concept.token }} {{ concept.property_line }}
{% endif %}
{% for designation in concept.designations %}
* {{ concept.token }} ^designation[+].language = #{{ designation.locale }}
* {{ concept.token }} ^designation[=].value = {{ designation.value_literal }}
{% endfor %}
{% endfor %}

ValueSet: {{ base_name }}VS
Id: {{ id_stem }}{{ slug }}-vs
Title: {{ title }}
Description: {{ description }}
{% for translation in title_translations %}
* ^title.extension[+].url = "{{ translation_extension_url }}"
* ^title.extension[=].extension[+].url = "lang"
* ^title.extension[=].extension[=].valueCode = #{{ translation.locale }}
* ^title.extension[=].extension[+].url = "content"
* ^title.extension[=].extension[=].valueString = {{ translation.value_literal }}
{% endfor %}
{% for identifier in identifiers %}
* ^identifier[+].system = "{{ identifier.system }}"
* ^identifier[=].value = "{{ identifier.value }}"
{% endfor %}
* ^status = #active
* include codes from system {{ base_name }}CS

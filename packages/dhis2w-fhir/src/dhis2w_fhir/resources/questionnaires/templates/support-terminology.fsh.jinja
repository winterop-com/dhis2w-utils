CodeSystem: {{ terminology.code_system }}
Id: {{ terminology.code_system_id }}
Title: {{ terminology.title_literal }}
Description: {{ terminology.description_literal }}
* ^status = #{{ terminology.ig_status }}
* ^experimental = {{ "true" if terminology.experimental else "false" }}
* ^content = #complete
* ^caseSensitive = true
* ^valueSet = Canonical({{ terminology.value_set }})
{% if terminology.declares_code %}
* ^property[+].code = #dhis2-code
* ^property[=].uri = "{{ terminology.property_base }}/dhis2-code"
* ^property[=].description = {{ terminology.property_description_literal }}
* ^property[=].type = #string
{% endif %}
{% if terminology.declares_domain %}
* ^property[+].code = #domain
* ^property[=].uri = "{{ terminology.property_base }}/domain"
* ^property[=].description = {{ terminology.domain_property_description_literal }}
* ^property[=].type = #code
{% endif %}
{% if terminology.declares_value_type %}
* ^property[+].code = #value-type
* ^property[=].uri = "{{ terminology.property_base }}/value-type"
* ^property[=].description = {{ terminology.value_type_property_description_literal }}
* ^property[=].type = #code
{% endif %}
{% if terminology.declares_unique %}
* ^property[+].code = #unique
* ^property[=].uri = "{{ terminology.property_base }}/unique"
* ^property[=].description = {{ terminology.unique_property_description_literal }}
* ^property[=].type = #boolean
{% endif %}
{% if terminology.declares_searchable %}
* ^property[+].code = #searchable
* ^property[=].uri = "{{ terminology.property_base }}/searchable"
* ^property[=].description = {{ terminology.searchable_property_description_literal }}
* ^property[=].type = #boolean
{% endif %}
{% for declaration in terminology.searchable_declarations %}
* ^property[+].code = #{{ declaration.property_code }}
* ^property[=].uri = "{{ declaration.uri }}"
* ^property[=].description = {{ declaration.description_literal }}
* ^property[=].type = #boolean
{% endfor %}
{% for declaration in terminology.category_declarations %}
* ^property[+].code = #{{ declaration.property_code }}
* ^property[=].uri = "{{ declaration.uri }}"
* ^property[=].description = {{ declaration.description_literal }}
* ^property[=].type = #Coding
{% endfor %}
{% for concept in terminology.concepts %}
* #{{ concept.uid }} {{ concept.display_literal }}
{% if concept.code_literal is not none %}
* #{{ concept.uid }} ^property[+].code = #dhis2-code
* #{{ concept.uid }} ^property[=].valueString = {{ concept.code_literal }}
{% endif %}
{% if concept.domain_code is not none %}
* #{{ concept.uid }} ^property[+].code = #domain
* #{{ concept.uid }} ^property[=].valueCode = #{{ concept.domain_code }}
{% endif %}
{% if concept.value_type_code is not none %}
* #{{ concept.uid }} ^property[+].code = #value-type
* #{{ concept.uid }} ^property[=].valueCode = #{{ concept.value_type_code }}
{% endif %}
{% if concept.unique_literal is not none %}
* #{{ concept.uid }} ^property[+].code = #unique
* #{{ concept.uid }} ^property[=].valueBoolean = {{ concept.unique_literal }}
{% endif %}
{% if concept.searchable_literal is not none %}
* #{{ concept.uid }} ^property[+].code = #searchable
* #{{ concept.uid }} ^property[=].valueBoolean = {{ concept.searchable_literal }}
{% endif %}
{% for searchable in concept.searchable_contexts %}
* #{{ concept.uid }} ^property[+].code = #{{ searchable.property_code }}
* #{{ concept.uid }} ^property[=].valueBoolean = {{ searchable.literal }}
{% endfor %}
{% for category_property in concept.category_properties %}
* #{{ concept.uid }} ^property[+].code = #{{ category_property.property_code }}
* #{{ concept.uid }} ^property[=].valueCoding = {{ category_property.coding_literal }}
{% endfor %}
{% for designation in concept.designations %}
* #{{ concept.uid }} ^designation[+].language = #{{ designation.locale }}
* #{{ concept.uid }} ^designation[=].value = {{ designation.value_literal }}
{% endfor %}
{% endfor %}

ValueSet: {{ terminology.value_set }}
Id: {{ terminology.value_set_id }}
Title: {{ terminology.title_literal }}
Description: {{ terminology.description_literal }}
* ^status = #{{ terminology.ig_status }}
* ^experimental = {{ "true" if terminology.experimental else "false" }}
* include codes from system {{ terminology.code_system }}

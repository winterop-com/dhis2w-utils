CodeSystem: {{ terminology.code_system }}
Id: {{ terminology.code_system_id }}
Title: {{ terminology.title_literal }}
Description: {{ terminology.description_literal }}
* ^status = #{{ terminology.ig_status }}
* ^experimental = {{ "true" if terminology.experimental else "false" }}
* ^content = #complete
* ^caseSensitive = true
* ^valueSet = Canonical({{ terminology.value_set }})
* ^property[+].code = #dhis2-code
* ^property[=].uri = "{{ terminology.property_base }}/dhis2-code"
* ^property[=].description = {{ terminology.property_description_literal }}
* ^property[=].type = #string
{% if terminology.declares_domain %}
* ^property[+].code = #domain
* ^property[=].uri = "{{ terminology.property_base }}/domain"
* ^property[=].description = "DHIS2 data element domain type."
* ^property[=].type = #code
{% endif %}
{% if terminology.declares_value_type %}
* ^property[+].code = #value-type
* ^property[=].uri = "{{ terminology.property_base }}/value-type"
* ^property[=].description = "DHIS2 data element value type."
* ^property[=].type = #code
{% endif %}
{% for concept in terminology.concepts %}
* #{{ concept.uid }} {{ concept.display_literal }}
* #{{ concept.uid }} ^property[+].code = #dhis2-code
* #{{ concept.uid }} ^property[=].valueString = {{ concept.code_literal }}
{% if concept.domain_code is not none %}
* #{{ concept.uid }} ^property[+].code = #domain
* #{{ concept.uid }} ^property[=].valueCode = #{{ concept.domain_code }}
{% endif %}
{% if concept.value_type_code is not none %}
* #{{ concept.uid }} ^property[+].code = #value-type
* #{{ concept.uid }} ^property[=].valueCode = #{{ concept.value_type_code }}
{% endif %}
{% endfor %}

ValueSet: {{ terminology.value_set }}
Id: {{ terminology.value_set_id }}
Title: {{ terminology.title_literal }}
Description: {{ terminology.description_literal }}
* ^status = #{{ terminology.ig_status }}
* ^experimental = {{ "true" if terminology.experimental else "false" }}
* include codes from system {{ terminology.code_system }}

Instance: Questionnaire-{{ questionnaire.stem }}
InstanceOf: Questionnaire
Title: {{ questionnaire.title_literal }}
Description: {{ questionnaire.description_literal }}
Usage: #definition
* id = "{{ questionnaire.stem }}"
* extension[{{ questionnaire.form_type_extension }}].valueCode = #{{ questionnaire.form_type_code }}
{% if questionnaire.collects_incident_date is not none %}
* extension[{{ questionnaire.collects_incident_date_extension }}].valueBoolean = {{ "true" if questionnaire.collects_incident_date else "false" }}
{% endif %}
{% if questionnaire.assignment_reference is not none %}
* extension[{{ questionnaire.assignment_extension }}].valueReference = Reference({{ questionnaire.assignment_reference }})
{% endif %}
{% if questionnaire.attribute_option_combo_value_set is not none %}
* extension[{{ questionnaire.attribute_option_combos_extension }}].valueCanonical = Canonical({{ questionnaire.attribute_option_combo_value_set }})
{% endif %}
{% for attribute_value in questionnaire.attribute_values %}
* extension[{{ questionnaire.attribute_value_extension }}][+].extension[{{ attribute_id_sub_extension }}].valueString = {{ attribute_value.attribute_id_literal }}
{% if attribute_value.attribute_code_literal is not none %}
* extension[{{ questionnaire.attribute_value_extension }}][=].extension[{{ attribute_code_sub_extension }}].valueString = {{ attribute_value.attribute_code_literal }}
{% endif %}
* extension[{{ questionnaire.attribute_value_extension }}][=].extension[{{ attribute_value_sub_extension }}].valueString = {{ attribute_value.value_literal }}
{% endfor %}
* url = "{{ questionnaire.url }}"
* identifier[+].system = {{ questionnaire.identifier_system }}
* identifier[=].value = "{{ questionnaire.uid }}"
* identifier[+].system = {{ questionnaire.identifier_code_system }}
* identifier[=].value = {{ questionnaire.identifier_code_literal }}
{% for grouping_identifier in questionnaire.grouping_identifiers %}
* identifier[+].system = {{ grouping_identifier.system }}
* identifier[=].value = {{ grouping_identifier.value_literal }}
{% endfor %}
{% for attribute_identifier in questionnaire.attribute_identifiers %}
* identifier[+].system = {{ attribute_identifier.system_literal }}
* identifier[=].value = {{ attribute_identifier.value_literal }}
{% endfor %}
* name = "{{ questionnaire.name }}"
* title = {{ questionnaire.title_element_literal }}
{% for translation in questionnaire.title_translations %}
* title.extension[+].url = "{{ translation_extension_url }}"
* title.extension[=].extension[+].url = "lang"
* title.extension[=].extension[=].valueCode = #{{ translation.locale }}
* title.extension[=].extension[+].url = "content"
* title.extension[=].extension[=].valueString = {{ translation.value_literal }}
{% endfor %}
* description = {{ questionnaire.description_element_literal }}
* status = #{{ questionnaire.ig_status }}
* experimental = {{ "true" if questionnaire.experimental else "false" }}
* subjectType = #{{ questionnaire.subject_type }}
* code = {{ questionnaire.form_type_code_system }}#{{ questionnaire.form_type_code }}
{% for item in questionnaire.items %}
* {{ item.new_path }}.linkId = "{{ item.link_id }}"
{% if item.code_token is not none %}
* {{ item.path }}.code = {{ item.code_token }}
{% endif %}
* {{ item.path }}.text = {{ item.text_literal }}
{% for translation in item.text_translations %}
* {{ item.path }}.text.extension[+].url = "{{ translation_extension_url }}"
* {{ item.path }}.text.extension[=].extension[+].url = "lang"
* {{ item.path }}.text.extension[=].extension[=].valueCode = #{{ translation.locale }}
* {{ item.path }}.text.extension[=].extension[+].url = "content"
* {{ item.path }}.text.extension[=].extension[=].valueString = {{ translation.value_literal }}
{% endfor %}
* {{ item.path }}.type = #{{ item.type_code }}
{% if item.answer_value_set is not none %}
* {{ item.path }}.answerValueSet = Canonical({{ item.answer_value_set }})
{% endif %}
{% if item.required %}
* {{ item.path }}.required = true
{% endif %}
{% if item.repeats %}
* {{ item.path }}.repeats = true
{% endif %}
{% for bound in item.bounds %}
* {{ item.path }}.extension[+].url = "{{ bound.url }}"
* {{ item.path }}.extension[=].{{ bound.element }} = {{ bound.literal }}
{% endfor %}
{% if item.entity_level is not none %}
* {{ item.path }}.extension[+].url = "{{ questionnaire.entity_level_extension_url }}"
* {{ item.path }}.extension[=].valueBoolean = {{ "true" if item.entity_level else "false" }}
{% endif %}
{% if item.item_control %}
* {{ item.path }}.extension[+].url = "{{ item_control_extension_url }}"
* {{ item.path }}.extension[=].valueCodeableConcept = {{ item_control_code_system_url }}#gtable
{% endif %}
{% endfor %}

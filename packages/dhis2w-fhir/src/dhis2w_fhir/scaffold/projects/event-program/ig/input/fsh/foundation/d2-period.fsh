Extension: D2Period
Id: d2-period
Title: "DHIS2 reporting period"
Description: "A DHIS2 reporting period: its ISO identifier, its period type, and the dates it covers."
* ^status = #draft
* ^experimental = true
* ^context[+].type = #element

# pyproject.toml - this IG project is a uv project (scaffolded by `d2w fhir init`).
# `uv sync` installs the toolchain into .venv, and every make target drives it through
# `uv run d2w`. Commit uv.lock: it pins the exact d2w build this IG was generated with,
# so a regenerate is reproducible on any machine. Move the pin deliberately with
# `uv lock --upgrade`.

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "FHIR IG project scaffolded by d2w fhir init"
requires-python = ">=3.13"
dependencies = [
    "dhis2w-cli",
    "dhis2w-fhir",
    "dhis2w-fhir-serve",
]

# The three packages resolve from PyPI, and their own dependency floors keep the CLI,
# the generator, and the server on one release - a d2w whose fhir plugin is a different
# build than its core is not a combination anyone tests. uv.lock pins the exact
# versions. dhis2w-fhir-serve is what `d2w fhir serve` runs on, and its wheel ships the
# capture UI; drop it if this project never serves its IG. To track the repository's
# main branch instead of releases, add a [tool.uv.sources] entry per package:
# dhis2w-cli = { git = "https://github.com/winterop-com/dhis2w-utils", subdirectory = "packages/dhis2w-cli", branch = "main" }

DOCKER_IMAGE := fhir-ig
IG_DIR := ig
# n/a disables terminology validation for offline builds, but current IG publisher versions
# NPE on required bindings that need a server (e.g. Attachment.contentType on the GeoJSON
# boundary extension) - use n/a only if your content has no such bindings.
TX_SERVER ?= http://tx.fhir.org
# Override to run d2w from a checkout or straight from a git ref (no local install):
#   make generate D2W="uv run --project /path/to/dhis2w-utils d2w"
#   make generate D2W="uvx --from 'git+ssh://git@github.com/winterop-com/dhis2w-utils.git@main#     #subdirectory=packages/dhis2w-cli' --with 'dhis2w-fhir @ git+ssh://git@github.com/#     winterop-com/dhis2w-utils.git@main#subdirectory=packages/dhis2w-fhir' d2w"
D2W ?= d2w

.PHONY: help setup upgrade generate validate sushi build clean clean-all

help:  ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "%-12s %s\n", $$1, $$2}'

setup:  ## Build the SUSHI + IG publisher docker image
	docker build -t $(DOCKER_IMAGE) .

upgrade:  ## Rebuild the image from scratch, pulling the latest SUSHI + IG publisher
	docker build --pull --no-cache -t $(DOCKER_IMAGE) .

generate:  ## Regenerate FSH from DHIS2 metadata
	$(D2W) fhir generate all

validate:  ## Check the DHIS2 instance's codes/names for FHIR-safety (writes md/csv/pdf; exit 1 on errors)
	$(D2W) fhir validate

sushi:  ## Compile FSH to FHIR resources
	docker run --rm -v $$(pwd)/$(IG_DIR):/home/publisher/ig $(DOCKER_IMAGE) sushi .

build:  ## Run the full IG publisher
	docker run --rm -v $$(pwd)/$(IG_DIR):/home/publisher/ig $(DOCKER_IMAGE) \
		java -Xmx4g -jar /home/publisher/.ig-publisher/publisher.jar ig.ini -ig . -tx $(TX_SERVER)

clean:  ## Remove build output
	rm -rf $(IG_DIR)/fsh-generated $(IG_DIR)/output $(IG_DIR)/temp $(IG_DIR)/template

clean-all: clean  ## Remove build output and the package cache
	rm -rf $(IG_DIR)/input-cache

# fhir.toml.example - every option `d2w fhir generate` and `d2w fhir serve` understand,
# with its default. Copy what you need into fhir.toml; omitted options keep these defaults.

# DHIS2 profile to read metadata from. Explicit `-p` / `DHIS2_PROFILE` wins over this.
# profile = "myserver"

[ig]
id = "{{ ig_id }}"
canonical = "{{ canonical }}"
name = "{{ name }}"
title = "{{ title }}"
publisher = "{{ publisher }}"
# IG life cycle: "draft" while building; "active" for production - drives the
# sushi-config status and the status and experimental flags of every generated artifact.
status = "{{ status }}"

[generate]
# Base URI for the DHIS2 identifier systems. `generate foundation` writes it into
# foundation/d2-aliases.fsh as one alias family per DHIS2 object - $DHIS2-OU, $DHIS2-OS,
# $DHIS2-DS, $DHIS2-PROGRAM, $DHIS2-PS, $DHIS2-DE, $DHIS2-COC, $DHIS2-TE,
# $DHIS2-TRACKER-ENROLLMENT - each with a -CODE sibling where the object carries a DHIS2
# code ($DHIS2-OU-CODE, $DHIS2-OS-CODE, $DHIS2-DS-CODE, $DHIS2-PROGRAM-CODE,
# $DHIS2-PS-CODE), and into the business identifiers every generated instance carries.
identifier_system_base = "http://dhis2.org/fhir"
# Concept code source for option sets: "id" (option UID, DHIS2 code as property)
# or "code" (DHIS2 code when FHIR-valid, UID as property; invalid codes fall back).
concept_code_source = "id"
# IANA time zone the instance's zone-less timestamps are wall-clock readings in. Naming it
# stamps every emitted dateTime with the offset that zone stood at on that very instant,
# DST included; absent keeps the UTC reading.
# timezone = "Asia/Vientiane"
# Translation locales to emit (BCP-47 or DHIS2-style tags; absent = every locale found).
# locales = ["lo", "en"]

[generate.naming]
# The identity stem every artifact of an object derives from - resource id, canonical URL,
# file name, and FSH name follow one segment: "id" (the DHIS2 id - stable, collision-free),
# "code-or-id" (the DHIS2 code when usable and unique, else the id, with a note), or
# "code" (the DHIS2 code always; a missing, unusable, or colliding code refuses the run).
source = "id"
# Tokens composing FSH artifact names; ids derive from the kebab of each non-empty token.
# Defaults read by context: D2OS_Qdm5fPK5Ra9_CS / d2-os-Qdm5fPK5Ra9-cs (id source).
prefix = "D2"                       # "" drops the prefix (profiles keep a D2 token:
                                    # a profile cannot share its parent resource's name)
option_set = "OS"                   # e.g. "OptionSet"; "" drops the token
category = "CAT"                    # category CodeSystem/ValueSet names; "" drops the token
organisation_unit = "OU"            # must stay non-empty (e.g. "OrgUnit")
data_set = "DS"                     # data set Questionnaire names; "" drops the token
program = "PR"                      # event program Questionnaire names; "" drops the token
program_stage = "PS"                # tracker program stage Questionnaire names; "" drops the token

[generate.option_sets]
# optionSet UIDs to include (absent = all).
# include_ids = ["Qdm5fPK5Ra9"]

[generate.categories]
# category UIDs to include (absent = all); each one emits a CodeSystem/ValueSet pair
# whose concepts are that category's category options.
# include_ids = ["O5P6e8yu1T6"]

[generate.data_sets]
# Data set UIDs to emit as Questionnaires (absent or empty = all data sets).
# include_ids = ["BfMAe6Itzgt"]

[generate.event_programs]
# Program UIDs to emit as one Questionnaire each; selects WITHOUT_REGISTRATION programs
# (absent or empty = every event program). Tracker programs go under
# [generate.tracker_programs].
# include_ids = ["VBqh0ynB2wv"]

[generate.tracker_programs]
# Program UIDs to emit as per-stage Questionnaires; selects WITH_REGISTRATION programs
# (absent or empty selects every WITH_REGISTRATION program; one Questionnaire per program
# stage, filed under tracker-programs/<program stem>/<stage stem>.fsh).
# include_ids = ["IpHINAT79UW"]

[generate.examples]
# Example QuestionnaireResponses per questionnaire target, generated locally by default -
# no data endpoint is called unless `source` below opts in. 0 disables the target, 10 is
# the ceiling.
per_target = 1
# Where the answers come from. "synthetic": deterministic generated values, safe everywhere.
# "instance": real values fetched from the server - demo servers only, review before publishing.
source = "synthetic"

[generate.organisation_units]
# Scope to a subtree (org unit UID; absent = entire tree).
# root = "ImspTQPwCqd"
# Deepest hierarchy level to emit (absent = no level cap).
# max_level = 4
terminology = false                 # also emit the org-unit CodeSystem/ValueSet
                                    # with level/parent/dhis2-code properties

[serve]
# How `d2w fhir serve` runs this project - `make serve` and `make serve-live` read it too,
# so the port is stated once here rather than on every invocation. A command-line flag
# still wins over these.
host = "127.0.0.1"                  # loopback: the facade has no authentication, so
                                    # binding elsewhere is a deliberate act
port = 8080                         # a local dev DHIS2 commonly owns 8080; port = 8090
                                    # is the usual way out of that clash
strict_codes = false                # true refuses a captured answer whose code is outside
                                    # the served terminology instead of warning and storing
ui = false                          # true also serves the capture UI at / - `make serve-ui`
                                    # turns it on for one run without stating it here

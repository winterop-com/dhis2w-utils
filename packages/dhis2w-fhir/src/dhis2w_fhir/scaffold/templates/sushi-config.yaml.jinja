id: {{ ig_id }}
canonical: {{ canonical }}
name: {{ name }}
title: {{ title }}
description: {{ title }}, generated from DHIS2 metadata by d2w fhir.
status: {{ status }}
version: 0.1.0
fhirVersion: 4.0.1
copyrightYear: {{ year }}+
releaseLabel: ci-build
license: CC0-1.0
publisher:
  name: {{ publisher }}
{% if publisher_url %}
  url: {{ publisher_url }}
{% endif %}

# The publisher writes every resource as JSON, XML and Turtle, plus a rendered page per
# format. A DHIS2-derived IG publishes thousands of instances, so the two extra formats
# cost far more build time than they earn; JSON is what consumers and the tooling read.
parameters:
  excludexml: "true"
  excludettl: "true"

menu:
  Home: index.html
  Forms: forms.html
  Registry: registry.html
  Terminology: terminology.html
  Identifiers: identifiers.html
  Periods: periods.html
  Capture: capture.html
  Artifacts: artifacts.html

Extension: {{ names.period_extension }}
Id: {{ names.period_extension_id }}
Title: "DHIS2 reporting period"
Description: "A DHIS2 reporting period: its ISO identifier, its period type, and the dates it covers."
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* ^context[+].type = #element
* ^context[=].expression = "QuestionnaireResponse"
* ^context[+].type = #element
* ^context[=].expression = "MeasureReport"
* extension contains
    iso 1..1 and
    type 1..1 and
    period 0..1
* extension[iso] ^short = "The DHIS2 ISO period identifier (e.g. 202401)."
* extension[iso].value[x] only string
* extension[iso].valueString 1..1
* extension[type] ^short = "The DHIS2 period type this identifier is expressed in."
* extension[type].value[x] only code
* extension[type].valueCode 1..1
* extension[type].valueCode from {{ names.period_type_value_set }} (required)
* extension[period] ^short = "The date range the ISO period resolves to."
* extension[period].value[x] only Period

Extension: {{ names.period_type_extension }}
Id: {{ names.period_type_extension_id }}
Title: "DHIS2 period type"
Description: "The DHIS2 period type an aggregate form is reported under - the reporting frequency of the data set the Questionnaire was generated from. A response to the form states one period of this type on {{ names.period_extension }}, so a client knows which ISO period format the instance accepts before it builds one. Only an aggregate form declares it, because only a data set has a reporting frequency."
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* ^context[+].type = #element
* ^context[=].expression = "Questionnaire"
* value[x] only code
* valueCode 1..1
* valueCode from {{ names.period_type_value_set }} (required)

CodeSystem: {{ names.period_type_code_system }}
Id: {{ names.period_type_code_system_id }}
Title: {{ terminology.title_literal }}
Description: {{ terminology.description_literal }}
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* ^content = #complete
* ^caseSensitive = true
* ^valueSet = Canonical({{ names.period_type_value_set }})
{% for period_type in period_types %}
* #{{ period_type.name }} "{{ period_type.display }}"
{% endfor %}

ValueSet: {{ names.period_type_value_set }}
Id: {{ names.period_type_value_set_id }}
Title: {{ terminology.title_literal }}
Description: {{ terminology.value_set_description_literal }}
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* include codes from system {{ names.period_type_code_system }}

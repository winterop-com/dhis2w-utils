Extension: {{ names.attribute_option_combos_extension }}
Id: {{ names.attribute_option_combos_extension_id }}
Title: "DHIS2 attribute option combos"
Description: "The attribute option combos a form's responses may be keyed under, as the canonical of the ValueSet publishing them. Absent means the form's data set rides the default category combo, and its responses carry no {{ names.attribute_option_combo_extension }} extension."
* ^status = #{{ ig_status }}
* ^experimental = {{ "true" if experimental else "false" }}
* ^context[+].type = #element
* ^context[=].expression = "Questionnaire"
* value[x] only Canonical(ValueSet)
* valueCanonical 1..1

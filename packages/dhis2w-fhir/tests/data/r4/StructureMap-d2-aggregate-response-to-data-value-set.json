{
  "resourceType": "StructureMap",
  "id": "d2-aggregate-response-to-data-value-set",
  "url": "http://localhost:8080/fhir/StructureMap/d2-aggregate-response-to-data-value-set",
  "title": "DHIS2 aggregate response to data value set",
  "description": "How one aggregate QuestionnaireResponse becomes the DHIS2 data value set it is imported as, element by element. The map is the conversion contract a third party builds their own bridge from; it is not executed at runtime, and the rules whose meaning exceeds what a transform can state carry that on their own documentation.",
  "name": "D2AggregateResponseToDataValueSet",
  "status": "draft",
  "experimental": true,
  "structure": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse",
      "mode": "source",
      "alias": "QuestionnaireResponse"
    },
    {
      "url": "http://localhost:8080/fhir/StructureDefinition/d2-data-value-set",
      "mode": "target",
      "alias": "DataValueSet"
    }
  ],
  "group": [
    {
      "name": "AggregateResponseToDataValueSet",
      "typeMode": "none",
      "documentation": "One aggregate QuestionnaireResponse becomes one data value set.",
      "input": [
        {
          "name": "response",
          "type": "QuestionnaireResponse",
          "mode": "source"
        },
        {
          "name": "dataValueSet",
          "type": "DataValueSet",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "dataSet",
          "documentation": "The data set is a fact about the form rather than about the response: it is the http://dhis2.org/fhir/id/data-set identifier of the Questionnaire the response answers, so an engine executing this map needs that Questionnaire in scope.",
          "source": [
            {
              "context": "response",
              "element": "questionnaire",
              "variable": "questionnaire"
            }
          ],
          "target": [
            {
              "context": "dataValueSet",
              "contextType": "variable",
              "element": "dataSet",
              "transform": "evaluate",
              "parameter": [
                {
                  "valueString": "%questionnaire.resolve().identifier.where($this.system = 'http://dhis2.org/fhir/id/data-set').value"
                }
              ]
            }
          ]
        },
        {
          "name": "period",
          "documentation": "The DHIS2 ISO period is what the import is keyed by. The date range the same extension carries is a rendering of that period, and a range disagreeing with the ISO period is ignored rather than obeyed.",
          "source": [
            {
              "context": "response",
              "element": "extension",
              "variable": "reportingPeriod",
              "condition": "url = 'http://localhost:8080/fhir/StructureDefinition/d2-period'"
            }
          ],
          "rule": [
            {
              "name": "periodIsoExtension",
              "source": [
                {
                  "context": "reportingPeriod",
                  "element": "extension",
                  "variable": "isoExtension",
                  "condition": "url = 'iso'"
                }
              ],
              "rule": [
                {
                  "name": "periodIso",
                  "source": [
                    {
                      "context": "isoExtension",
                      "element": "value",
                      "variable": "iso"
                    }
                  ],
                  "target": [
                    {
                      "context": "dataValueSet",
                      "contextType": "variable",
                      "element": "period",
                      "transform": "copy",
                      "parameter": [
                        {
                          "valueId": "iso"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "orgUnit",
          "documentation": "The organisation unit is the http://dhis2.org/fhir/id/org-unit identifier of the published Location the response is subject to, so an engine executing this map needs the Location registry in scope. Reading the UID off the reference's own id is only correct where the guide names its Locations by DHIS2 id.",
          "source": [
            {
              "context": "response",
              "element": "subject",
              "variable": "subject"
            }
          ],
          "target": [
            {
              "context": "dataValueSet",
              "contextType": "variable",
              "element": "orgUnit",
              "transform": "evaluate",
              "parameter": [
                {
                  "valueString": "%subject.resolve().identifier.where($this.system = 'http://dhis2.org/fhir/id/org-unit').value"
                }
              ]
            }
          ]
        },
        {
          "name": "attributeOptionCombo",
          "documentation": "The response names its attribute option combo as a coding of the vocabulary its own form declares. The code is the DHIS2 UID wherever the guide's concept codes are DHIS2 ids; where they are DHIS2 codes, the combo's own ConceptMap translates the code onto http://dhis2.org/fhir/id/category-option-combo and this rule is that translation's input. A data set on the default category combo names no combo at all, and DHIS2 fills the field itself.",
          "source": [
            {
              "context": "response",
              "element": "extension",
              "variable": "attributeOptionComboExtension",
              "condition": "url = 'http://localhost:8080/fhir/StructureDefinition/d2-attribute-option-combo'"
            }
          ],
          "rule": [
            {
              "name": "attributeOptionComboCoding",
              "source": [
                {
                  "context": "attributeOptionComboExtension",
                  "element": "value",
                  "variable": "coding"
                }
              ],
              "rule": [
                {
                  "name": "attributeOptionComboCode",
                  "source": [
                    {
                      "context": "coding",
                      "element": "code",
                      "variable": "comboCode"
                    }
                  ],
                  "target": [
                    {
                      "context": "dataValueSet",
                      "contextType": "variable",
                      "element": "attributeOptionCombo",
                      "transform": "copy",
                      "parameter": [
                        {
                          "valueId": "comboCode"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "completeDate",
          "documentation": "The report is complete on the day the response records itself as authored. `authored` carries an offset and DHIS2 stores a zone-less wall clock, so a bridge reads the instant in the project's own time zone before taking its date part; the substring below is the structural claim, not the zone arithmetic.",
          "source": [
            {
              "context": "response",
              "element": "authored",
              "variable": "authored"
            }
          ],
          "target": [
            {
              "context": "dataValueSet",
              "contextType": "variable",
              "element": "completeDate",
              "transform": "evaluate",
              "parameter": [
                {
                  "valueString": "%authored.toString().substring(0, 10)"
                }
              ]
            }
          ]
        },
        {
          "name": "dataValues",
          "source": [
            {
              "context": "response",
              "element": "item",
              "variable": "item"
            }
          ],
          "dependent": [
            {
              "name": "ResponseItemToDataValues",
              "variable": [
                "item",
                "dataValueSet"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "ResponseItemToDataValues",
      "typeMode": "none",
      "documentation": "One answered item becomes one data value. A form's questions sit under section groups and a group carries no data value of its own, so the group recurses into its children and writes only where an answer is.",
      "input": [
        {
          "name": "item",
          "mode": "source"
        },
        {
          "name": "dataValueSet",
          "type": "DataValueSet",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "nestedItem",
          "source": [
            {
              "context": "item",
              "element": "item",
              "variable": "childItem"
            }
          ],
          "dependent": [
            {
              "name": "ResponseItemToDataValues",
              "variable": [
                "childItem",
                "dataValueSet"
              ]
            }
          ]
        },
        {
          "name": "answeredItem",
          "source": [
            {
              "context": "item",
              "element": "answer",
              "variable": "answer"
            }
          ],
          "target": [
            {
              "context": "dataValueSet",
              "contextType": "variable",
              "element": "dataValues",
              "variable": "dataValue",
              "transform": "create"
            }
          ],
          "rule": [
            {
              "name": "dataElement",
              "documentation": "The link-id grammar is the whole disaggregation contract: an undisaggregated question is answered on the data element UID alone, and one cell of a category grid on the data element UID, a dot, and the category option combo UID.",
              "source": [
                {
                  "context": "item",
                  "element": "linkId",
                  "variable": "linkId"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "dataElement",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%linkId.substring(0, %linkId.iif(%linkId.contains('.'), %linkId.indexOf('.'), %linkId.length()))"
                    }
                  ]
                }
              ]
            },
            {
              "name": "categoryOptionCombo",
              "source": [
                {
                  "context": "item",
                  "element": "linkId",
                  "variable": "linkId"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "categoryOptionCombo",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%linkId.iif(%linkId.contains('.'), %linkId.substring(%linkId.indexOf('.') + 1), {})"
                    }
                  ]
                }
              ]
            },
            {
              "name": "booleanValue",
              "documentation": "Every DHIS2 data value is a string on the wire, and one rule per answered `value[x]` type is what states that string: the validator types an evaluate expression against the element it reads, so a branch naming its own type is the form an expression over a choice can take. What no transform can state stays in prose: a TRUE_ONLY question answered false drops the whole cell, a MULTI_TEXT answer is the comma-joined set of its codes, a decimal keeps the lexical form it was captured in, a coded answer is resolved through the question's own terminology, and a zoned timestamp is read to the wall clock DHIS2 stores. `dhis2w_fhir.conversion.values` is the reference implementation of that table. An attachment answers no data value at all - DHIS2 stores a file resource through a separate upload - so no branch reads one.",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "boolean",
                  "variable": "answerBoolean"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerBoolean.toString()"
                    }
                  ]
                }
              ]
            },
            {
              "name": "decimalValue",
              "documentation": "A decimal keeps the lexical form the answer was captured in, so a whole number stays whole.",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "decimal",
                  "variable": "answerDecimal"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerDecimal.toString()"
                    }
                  ]
                }
              ]
            },
            {
              "name": "integerValue",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "integer",
                  "variable": "answerInteger"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerInteger.toString()"
                    }
                  ]
                }
              ]
            },
            {
              "name": "dateValue",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "date",
                  "variable": "answerDate"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerDate.toString()"
                    }
                  ]
                }
              ]
            },
            {
              "name": "dateTimeValue",
              "documentation": "A zoned timestamp is read back to the zone-less wall clock DHIS2 stores before it is written; the copy below is the structural claim, not the zone arithmetic.",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "dateTime",
                  "variable": "answerDateTime"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerDateTime.toString()"
                    }
                  ]
                }
              ]
            },
            {
              "name": "timeValue",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "time",
                  "variable": "answerTime"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerTime.toString()"
                    }
                  ]
                }
              ]
            },
            {
              "name": "stringValue",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "string",
                  "variable": "answerString"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerString.toString()"
                    }
                  ]
                }
              ]
            },
            {
              "name": "uriValue",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "uri",
                  "variable": "answerUri"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerUri.toString()"
                    }
                  ]
                }
              ]
            },
            {
              "name": "codedValue",
              "documentation": "A coded answer is stored as the code of the option it names, which is the DHIS2 option code wherever the guide's concept codes are DHIS2 codes.",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "Coding",
                  "variable": "answerCoding"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerCoding.code"
                    }
                  ]
                }
              ]
            },
            {
              "name": "organisationUnitValue",
              "documentation": "An organisation-unit answer references a published Location, and the data value is that Location's http://dhis2.org/fhir/id/org-unit identifier.",
              "source": [
                {
                  "context": "answer",
                  "element": "value",
                  "type": "Reference",
                  "variable": "answerReference"
                }
              ],
              "target": [
                {
                  "context": "dataValue",
                  "contextType": "variable",
                  "element": "value",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "%answerReference.resolve().identifier.where($this.system = 'http://dhis2.org/fhir/id/org-unit').value"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
